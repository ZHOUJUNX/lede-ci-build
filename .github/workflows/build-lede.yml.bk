name: Build LEDE OpenWrt Firmware

on:
  workflow_dispatch:

jobs:
  build:
    name: Compile Lede Firmware
    runs-on: ubuntu-22.04
    timeout-minutes: 360
    steps:
      - name: Checkout repository code
        uses: actions/checkout@v4

      - name: Show workspace files
        run: ls -la

      - name: Clear git proxy config
        run: |
          git config --global --unset-all url."https://mirror.ghproxy.com/https://github.com".insteadOf || true

      # 仅缓存dl源码包，减少重复下载
      - name: Cache dl source
        uses: actions/cache@v4
        with:
          path: lede/dl
          key: ${{ runner.os }}-lede-dl-${{ github.run_id }}
          restore-keys: |
            ${{ runner.os }}-lede-dl-

      - name: Run build script
        run: |
          export FORCE_UNSAFE_CONFIGURE=1
          ./lede_build.sh

      - name: Upload firmware artifact
        uses: actions/upload-artifact@v4
        with:
          name: lede-firmware
          path: firmware/*.zip
          retention-days: 30
